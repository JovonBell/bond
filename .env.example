# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Slack ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=any-random-string-for-oauth-state
SLACK_REDIRECT_URI=https://YOUR-RAILWAY-URL.up.railway.app/slack/oauth_redirect

# --- Pipedream Connect ---
PIPEDREAM_PROJECT_ID=proj_JPsbdAR
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_ENVIRONMENT=development

# --- App ---
APP_URL=https://YOUR-RAILWAY-URL.up.railway.app
PORT=3000

# --- Database ---
# Railway auto-injects DATABASE_URL when you add a Postgres service
DATABASE_URL=postgres://user:pass@host:5432/db
